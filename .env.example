# Copy to .env and change every value. Never commit .env.
POSTGRES_PASSWORD=change-me
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HCPP_JWT_SECRET=change-me-to-a-long-random-string
# development | production  (production requires HTTPS + HCPP_COOKIE_SECURE=true)
HCPP_ENVIRONMENT=development
HCPP_COOKIE_SECURE=false
